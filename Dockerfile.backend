# ============================================================================
# MarketGPS Backend Dockerfile (PRODUCTION)
# Build context: Project root (.)
# ============================================================================

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# IMPORTANT: PYTHONPATH includes both /app and /app/backend for all imports
ENV PYTHONPATH=/app:/app/backend

WORKDIR /app

# Install runtime dependencies, gosu (for entrypoint), and create non-root user
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gosu \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system appuser && useradd --system --gid appuser appuser

# Copy requirements
COPY backend/requirements.txt backend/requirements.txt
COPY requirements.txt requirements.txt

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip

# Install heavy dependencies separately to avoid memory issues/timeouts during build
RUN pip install --no-cache-dir numpy pandas pyarrow grpcio

RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir -r backend/requirements.txt

# ============================================================================
# Copy ALL necessary modules
# ============================================================================

# Backend code (main application)
COPY backend/ backend/

# Storage module (SQLite store, Parquet store, migrations)
COPY storage/ storage/

# Core module (config, models, utils, scoring specs)
COPY core/ core/

# Providers module (data providers: yfinance, tiingo, etc.)
COPY providers/ providers/

# Pipeline module (jobs, scheduler) - needed for some imports
COPY pipeline/ pipeline/

# Auth module
COPY auth/ auth/

# Schema file
COPY schema.sql ./

# Data files (universe CSVs for Africa, etc.)
COPY data/universe/ data/universe/

# Scripts (expand_universe.py, etc.)
COPY scripts/ scripts/

# Entrypoint script (fixes bind-mount permissions, then drops to appuser)
COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Create data/logs directories and set ownership
RUN mkdir -p /app/data /app/logs /app/data/parquet /app/data/sqlite /app/data/article-videos && \
    chown -R appuser:appuser /app

# NOTE: Do NOT set USER here — entrypoint.sh runs as root to fix
# bind-mount permissions, then drops to appuser via gosu

# IMPORTANT: on se place dans backend
WORKDIR /app/backend

EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=90s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Entrypoint fixes permissions then drops to appuser
ENTRYPOINT ["/app/entrypoint.sh"]

# Production: 2 workers (adjust based on VPS CPU cores)
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
