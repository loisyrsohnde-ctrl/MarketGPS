# Dependencies (will be reinstalled during build)
node_modules/

# iOS - Exclude entire ios folder (will be regenerated by prebuild)
ios/

# Android - Exclude entire android folder
android/

# Android build artifacts
android/.gradle/
android/build/
android/app/build/

# Expo cache
.expo/
.expo-shared/

# Metro bundler cache
.metro-health-check-*

# Development files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test files
__tests__/
*.test.js
*.test.ts
*.test.tsx
*.spec.js
*.spec.ts
*.spec.tsx
coverage/

# Documentation
*.md
!README.md

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Environment files (secrets handled by EAS)
.env
.env.local
.env.development
.env.production

# Git
.git/
.gitignore

# Other
*.tgz
*.tar.gz
*.zip
