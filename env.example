# ============================================================================
# MarketGPS Environment Variables - Complete Reference
# ============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git! This file contains sensitive keys.
#
# Structure:
#   - Common/shared variables for both frontend and backend
#   - Frontend-specific variables (NEXT_PUBLIC_*)
#   - Backend-specific variables
#
# Requirements:
#   - All REQUIRED variables must be filled in
#   - Optional variables can be left empty
# ============================================================================


# ============================================================================
# SUPABASE CONFIGURATION
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# ============================================================================

# Supabase Project URL (e.g., https://xxxxxxxxxxxx.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Key (public key, safe for frontend)
# Starts with "eyJ" and is around 200+ characters
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (SECRET! Backend only - has full database access)
# Starts with "eyJ" and is around 200+ characters
# ⚠️  NEVER expose this to the frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase JWT Secret (optional, for custom JWT verification)
# Extract from Supabase dashboard if needed
SUPABASE_JWT_SECRET=your-jwt-secret


# ============================================================================
# DATA PROVIDER - EODHD (End of Day Historical Data)
# Get API key from: https://eodhd.com
# ============================================================================

# EODHD API Key (required for market data fetching)
# Free tier provides basic data access
EODHD_API_KEY=your-eodhd-api-key-here

# EODHD API Base URL (defaults to https://eodhd.com/api)
EODHD_BASE_URL=https://eodhd.com/api

# Default exchange for EODHD queries (e.g., US, XETRA, XBUD)
DEFAULT_EXCHANGE=US


# ============================================================================
# AI & LLM SERVICES
# ============================================================================

# OpenAI API Key (for ChatGPT strategy generation)
# Get from: https://platform.openai.com/account/api-keys
# Format: sk-proj-xxxxx... (about 100+ characters)
# Leave empty to disable AI strategy features
OPENAI_API_KEY=sk-proj-your-api-key-here

# Optional: Anthropic/Claude API Key (future support)
# CLAUDE_API_KEY=your-claude-api-key-here


# ============================================================================
# EMAIL SERVICE - RESEND
# Get API key from: https://resend.com
# ============================================================================

# Resend API Key (for transactional emails)
# Format: re_xxxxx... (about 100+ characters)
RESEND_API_KEY=re_your-resend-api-key-here

# Sender email address for transactional emails
# Format: "Name <email@domain.com>"
EMAIL_FROM=MarketGPS <noreply@marketgps.online>

# Enable/disable email sending globally (true/false)
# Useful for development to prevent accidental emails
EMAIL_ENABLED=true


# ============================================================================
# PAYMENT PROCESSING - STRIPE
# Get these from: https://dashboard.stripe.com/apikeys
# ============================================================================

# Stripe Secret Key (backend only - has payment access)
# Test key: sk_test_xxxxx...
# Live key: sk_live_xxxxx...
# ⚠️  NEVER expose to frontend
STRIPE_SECRET_KEY=sk_test_your-secret-key-here

# Stripe Public Key (frontend safe - no sensitive data)
# Test key: pk_test_xxxxx...
# Live key: pk_live_xxxxx...
STRIPE_PUBLIC_KEY=pk_test_your-public-key-here

# Stripe Webhook Signing Secret
# Get from: Dashboard > Developers > Webhooks > Click endpoint > Signing secret
# Format: whsec_xxxxx... (about 100+ characters)
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# Stripe Price IDs (from Product Catalog)
# Create prices in Stripe Dashboard and copy the IDs here
STRIPE_PRICE_MONTHLY=price_xxxxx  # Monthly subscription price ID
STRIPE_PRICE_YEARLY=price_xxxxx   # Yearly subscription price ID

# QuantAI Academy (one-time payment product)
# Create a one-time product at 499 EUR in Stripe Dashboard
STRIPE_PRICE_ID_ACADEMY=price_xxxxx  # Academy formation price ID (499 EUR one-time)

# Stripe Coupon for annual subscriber discount on Academy (199 EUR instead of 499 EUR)
# Create a coupon in Stripe: Dashboard > Products > Coupons > amount_off=30000, currency=eur
# This gives 300 EUR off the 499 EUR price = 199 EUR final
STRIPE_COUPON_ID_ACADEMY_ANNUAL=coupon_xxxxx


# ============================================================================
# APPLICATION URLS & CONFIGURATION
# ============================================================================

# Billing mode: "dev" (direct activation) or "stripe" (payment required)
BILLING_MODE=dev

# Frontend URLs for redirects
FRONTEND_URL=https://app.marketgps.online
APP_BASE_URL=http://localhost:8501
BACKEND_API_BASE_URL=http://localhost:8000

# Frontend API URL (used by Next.js frontend)
NEXT_PUBLIC_API_URL=https://api.marketgps.online
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase URLs for frontend (public, safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Stripe success/cancel URLs (for redirect after checkout)
FRONTEND_SUCCESS_URL=http://localhost:8501/billing?success=1
FRONTEND_CANCEL_URL=http://localhost:8501/billing?canceled=1

# Bypass paywall in development (frontend only)
NEXT_PUBLIC_BYPASS_PAYWALL=false


# ============================================================================
# SECURITY & CORS
# ============================================================================

# Admin Key for admin dashboard access (REQUIRED in production)
# Generate a strong random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_KEY

# Internal API Key for pipeline-to-backend communication (REQUIRED in production)
# Generate a strong random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_KEY

# Grafana monitoring credentials (if using docker-compose.monitoring.yml)
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD

# Additional CORS origins (comma-separated)
# In production, only production domains are allowed by default.
# In development, localhost origins are included automatically.
CORS_ORIGINS=

# Environment: development, staging, production
# Controls security behavior (CORS, auth enforcement, error details)
ENV=development


# ============================================================================
# STORAGE & DATA CONFIGURATION
# ============================================================================

# Data directory for local storage
# Defaults to ./data if not specified
DATA_DIR=./data

# SQLite database path
# Defaults to ./data/sqlite/marketgps.db if not specified
SQLITE_PATH=./data/sqlite/marketgps.db


# ============================================================================
# PIPELINE CONFIGURATION
# ============================================================================

# Batch size for portfolio rotation analysis
ROTATION_BATCH_SIZE=50

# Rotation analysis interval (minutes)
# How often to run portfolio rotation analysis
ROTATION_PERIOD_MINUTES=15

# Scheduler: Portfolio rotation interval (minutes)
SCHEDULE_ROTATION_MINUTES=15

# Scheduler: Gating analysis interval (hours)
# Gating filters assets by liquidity and quality metrics
SCHEDULE_GATING_HOURS=6

# Scheduler: Pool rebalancing interval (hours)
SCHEDULE_POOL_HOURS=6

# Scheduler: Universe update interval (days)
# How often to fetch new market data
SCHEDULE_UNIVERSE_DAYS=7


# ============================================================================
# NEWS & NOTIFICATIONS
# ============================================================================

# News processing interval (minutes)
# How often to fetch and process market news
NEWS_INTERVAL_MINUTES=30

# News processing window: Start hour (24h format, e.g., 6 = 6 AM)
NEWS_START_HOUR=6

# News processing window: End hour (24h format, e.g., 21 = 9 PM)
NEWS_END_HOUR=21

# Minimum interactions required to surface a news item
NEWS_MIN_INTERACTIONS=50

# Run news processing on startup (true/false)
NEWS_RUN_ON_START=true


# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Backend API port
PORT=8000

# Debug mode (true/false)
# Enable for development, disable for production
DEBUG=true

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Environment: development, staging, production
ENVIRONMENT=development


# ============================================================================
# AI QUOTA LIMITS (Optional)
# ============================================================================

# Maximum OpenAI requests per user (default: 50)
# Set to -1 for unlimited
# OPENAI_QUOTA_LIMIT=50

# Maximum Gemini requests per user (default: 50)
# GEMINI_QUOTA_LIMIT=50
