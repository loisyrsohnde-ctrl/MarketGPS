# ============================================================================
# MarketGPS Backend Environment Variables
# Copy this file to .env and fill in the values
# ============================================================================

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PORT=8000
LOG_LEVEL=INFO

# ============================================================================
# DATABASE
# ============================================================================
# SQLite database path (relative or absolute)
SQLITE_PATH=./data/marketgps.db
DATA_DIR=./data

# ============================================================================
# CORS (Cross-Origin Resource Sharing)
# ============================================================================
# Comma-separated list of allowed origins
# Local development defaults: http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000
# Production example: https://app.marketgps.online,https://app.afristocks.eu
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================================================
# ADMIN & API SECURITY
# ============================================================================
# Admin API key for protected endpoints
ADMIN_KEY=CHANGE_ME_IN_PRODUCTION

# Secret key for session/JWT signing (generate: openssl rand -hex 32)
SECRET_KEY=your-secret-key-change-in-production

# ============================================================================
# SUPABASE (Authentication & Database)
# ============================================================================
# Get from https://supabase.com/ - Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-jwt-secret

# ============================================================================
# STRIPE BILLING (Optional - required for subscriptions)
# ============================================================================
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_xxx...

# Get from https://dashboard.stripe.com/webhooks (after creating endpoint)
STRIPE_WEBHOOK_SECRET=whsec_xxx...

# Get from https://dashboard.stripe.com/products (after creating prices)
STRIPE_PRICE_MONTHLY_ID=price_xxx...
STRIPE_PRICE_YEARLY_ID=price_xxx...

# Frontend URLs for Stripe redirects
FRONTEND_SUCCESS_URL=https://app.marketgps.online/billing?success=1
FRONTEND_CANCEL_URL=https://app.marketgps.online/billing?canceled=1

# Grace period for past_due subscriptions (hours)
BILLING_GRACE_PERIOD_HOURS=48

# ============================================================================
# DATA PROVIDERS - FINANCIAL
# ============================================================================
# EODHD API Key (for stocks, ETFs, FX worldwide)
# Get from: https://eodhd.com/
EODHD_API_KEY=

# ============================================================================
# DATA PROVIDERS - REAL ESTATE & NEWS (Optional)
# ============================================================================
# FRED API Key (Federal Reserve Economic Data - for US rates)
# Get from: https://fred.stlouisfed.org/docs/api/api_key.html (FREE)
FRED_API_KEY=

# NewsAPI Key (for news aggregation)
# Get from: https://newsapi.org/ (FREE tier: 100 requests/day)
NEWSAPI_KEY=

# INSEE API Token (for French real estate statistics)
# Get from: https://api.insee.fr/ (FREE with registration)
INSEE_API_TOKEN=

# ============================================================================
# AI / LLM PROVIDERS (Optional)
# ============================================================================
# OpenAI API Key (for news article rewriting, video scripts)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Gemini API Key (for Visual Inspector image analysis)
# Get from: https://ai.google.dev/
GEMINI_API_KEY=AIzaSyxxx...

# ============================================================================
# FEATURE FLAGS & PIPELINE
# ============================================================================
# Market scope: US_EU or AFRICA
MARKET_SCOPE=US_EU

# Run pipeline on scheduler startup
RUN_ON_START=false

# ============================================================================
# NEWS SCRAPING & PROCESSING
# ============================================================================
# LLM provider for article processing (openai, gemini, etc.)
LLM_PROVIDER=openai

# Minimum interactions for articles to be considered "trending"
MIN_TRENDING_INTERACTIONS=100
